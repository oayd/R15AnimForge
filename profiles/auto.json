    "Head": ["head"],
    "LeftUpperArm": ["l upperarm", "l upper arm"],
    "LeftLowerArm": ["l forearm", "l lowerarm", "l lower arm"],
    "LeftHand": ["l hand"],
    "RightUpperArm": ["r upperarm", "r upper arm"],
    "RightLowerArm": ["r forearm", "r lowerarm", "r lower arm"],
    "RightHand": ["r hand"],
    "LeftUpperLeg": ["l thigh", "l upperleg", "l upper leg"],
    "LeftLowerLeg": ["l calf", "l lowerleg", "l lower leg", "l shin"],
    "LeftFoot": ["l foot"],
    "RightUpperLeg": ["r thigh", "r upperleg", "r upper leg"],
    "RightLowerLeg": ["r calf", "r lowerleg", "r lower leg", "r shin"],
    "RightFoot": ["r foot"]
  },
